import time
import fill_function as fill

def main():
    fill.set_current_position(0)  # Startpunkt
    
    #Getränk befüllen
    # in die Klammern Namen des Getränks schreiben, bei mehreren Getränken einfach kopieren
    fill.move_to_drink("")
    fill.pour_with_servo(fill.SERVO_PINS[""], dwell=0.7)
    time.sleep(0.5)

    

    fill._setup_driver()
    try:
        fill.move_to_position(0)  # zurück zum Start
    finally:
        fill._cleanup_driver()

if __name__ == "__main__":
    main()
